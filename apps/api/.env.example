# Copy to .env for local development. Never commit the real file.
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Local Postgres from docker-compose.yml at the repository root.
DATABASE_URL=postgresql://centiverse:centiverse@localhost:5432/centiverse?schema=public

# Origins allowed to send credentialed requests (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:1420

LOG_LEVEL=info

# The test suite creates and migrates this database itself.
TEST_DATABASE_URL=postgresql://centiverse:centiverse@localhost:5432/centiverse_test?schema=public
