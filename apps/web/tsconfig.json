{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    /* §7.2 — incremental migration: JS is allowed in, but never type-checked.
       New files are .ts/.tsx. Migrate leaf-first: utils -> data -> hooks -> components -> pages. */
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,

    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vitest/globals"],

    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.js"]
}
